{
  "name": "nodra",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nodra",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
      }
    },
    "apps/api": {
      "name": "@nodra/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@nodra/web",
      "version": "0.0.0"
    },
    "apps/worker": {
      "name": "@nodra/worker",
      "version": "0.0.0"
    },
    "node_modules/@nodra/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@nodra/attestcoin": {
      "resolved": "packages/attestcoin",
      "link": true
    },
    "node_modules/@nodra/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@nodra/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@nodra/underwriting": {
      "resolved": "packages/underwriting",
      "link": true
    },
    "node_modules/@nodra/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@nodra/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/attestcoin": {
      "name": "@nodra/attestcoin",
      "version": "0.0.0",
      "dependencies": {
        "@nodra/domain": "0.0.0"
      }
    },
    "packages/config": {
      "name": "@nodra/config",
      "version": "0.0.0"
    },
    "packages/domain": {
      "name": "@nodra/domain",
      "version": "0.0.0"
    },
    "packages/underwriting": {
      "name": "@nodra/underwriting",
      "version": "0.0.0"
    }
  }
}
